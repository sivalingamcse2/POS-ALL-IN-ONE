# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# PostgreSQL (optional - app works without it using local JSON storage)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Cloud Storage (optional)
CLOUD_STORAGE_URL=

# Client (Vite) - build-time variable, read from client/.env or CI env
# When the backend is hosted separately (e.g. Render), set this to its full
# origin. If empty, the client falls back to same-origin /api.
# Example: https://pos-api-abc123.onrender.com
VITE_API_URL=
